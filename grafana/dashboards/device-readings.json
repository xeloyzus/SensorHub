  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "sensorhub-timescale" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 16, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "sensorhub-timescale" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(r.time, '5m'), d.label || ' - ' || r.metric AS metric, avg(r.value) AS value FROM readings r JOIN devices d ON d.id = r.device_id JOIN buildings b ON b.id = d.building_id WHERE $__timeFilter(r.time) AND r.metric = ${metric:sqlstring} GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Live readings by device - selected metric",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "sensorhub-timescale" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false } },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 8, "x": 16, "y": 0 },
      "id": 2,
      "options": { "showHeader": true, "sortBy": [{ "desc": true, "displayName": "time" }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "sensorhub-timescale" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT b.name AS building, d.label AS device, upper(d.eui) AS dev_eui, coalesce(d.room, '') AS room, latest.metric AS metric, latest.time AS time, latest.value AS value, CASE WHEN latest.time IS NULL THEN 'No readings stored' WHEN latest.time > now() THEN 'Future timestamp' WHEN latest.time < now() - INTERVAL '45 minutes' THEN 'Stale' ELSE 'Reporting' END AS status FROM devices d JOIN buildings b ON b.id = d.building_id LEFT JOIN LATERAL (SELECT DISTINCT ON (r.metric) r.metric, r.time, r.value FROM readings r WHERE r.device_id = d.id ORDER BY r.metric, r.time DESC) latest ON true ORDER BY b.name, d.label, latest.metric",
          "refId": "A"
        }
      ],
      "title": "Latest stored value for every device and metric",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "sensorhub-timescale" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "sensorhub-timescale" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT d.id) AS devices FROM readings r JOIN devices d ON d.id = r.device_id WHERE $__timeFilter(r.time)",
          "refId": "A"
        }
      ],
      "title": "Devices with readings in selected time range",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "sensorhub-timescale" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Stored measurements", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none", "group": "A" } }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "sensorhub-timescale" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(r.time, '15m'), d.label AS device, count(*) AS value FROM readings r JOIN devices d ON d.id = r.device_id WHERE $__timeFilter(r.time) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Measurements received per device",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
