# Caddy reverse proxy: automatic HTTPS. All requests are proxied to FastAPI,
# which serves the dashboard (templates + static) and the JSON API.

{$DOMAIN} {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	reverse_proxy api:8000
}
