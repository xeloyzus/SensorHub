# Campus dashboard environment template. For first setup run:
#   python3 scripts/setup_env.py
# It asks for the server address and creates `.env` with random credentials.
# For manual configuration, copy this file and replace all placeholders/blanks.
# `.env` must never be committed to git.

# --- Database -------------------------------------------------------------
POSTGRES_DB=sensorhub
POSTGRES_USER=sensorhub
# Use a long, random value (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=
DATABASE_URL=

# --- MQTT (internal integrations / optional legacy gateway path) ---------
MQTT_PORT=1883
# Keep loopback. The Semtech gateway path reaches MQTT only inside Docker.
# This plaintext listener must never be exposed to the public internet.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_GATEWAY_PASSWORD=
MQTT_INGEST_PASSWORD=
MQTT_CHIRPSTACK_PASSWORD=
MQTT_FORWARDER_PASSWORD=
MQTT_BRIDGE_PASSWORD=
# ChirpStack v4. For v3, use application/+/device/+/rx.
# Update mosquitto/acl as well if your gateway uses a different topic layout.
MQTT_TOPIC=application/+/device/+/event/up

# --- ChirpStack -----------------------------------------------------------
# Admin UI is private to this PC by default. Use a VPN-bound address only if
# remote administration is needed; do not expose it publicly without a proxy.
CHIRPSTACK_BIND_ADDRESS=127.0.0.1
CHIRPSTACK_HTTP_PORT=8081
CHIRPSTACK_POSTGRES_PASSWORD=
# Random secret for ChirpStack API token signing.
CHIRPSTACK_API_SECRET=
# Semtech UDP listener for UG65 packet forwarders. Restrict UDP 1700 to
# gateway IPs with the server firewall or bind to a private interface address.
GATEWAY_BRIDGE_BIND_ADDRESS=0.0.0.0

# --- Public dashboard -----------------------------------------------------
# Optional canonical HTTP(S) origin used by QR codes. Leave blank to use the
# address opened by the screen. Set a phone-reachable URL for signage;
# localhost on a phone points to the phone itself.
PUBLIC_BASE_URL=
# Hostname for HTTPS, or http://SERVER_IP for local HTTP.
# Arrange DNS and the Linux PC's public route with UiS IT for public access.
DOMAIN=localhost
# Published web ports. First-run --local uses HTTP port 8080.
HTTP_PORT=80
HTTPS_PORT=443
# Display/API refresh interval. Keep at 60s unless sensor reporting changes.
DISPLAY_REFRESH_SECONDS=60

# --- Grafana (internal admin) ---------------------------------------------
GRAFANA_ADMIN_USER=admin
# Another long, random value.
GRAFANA_ADMIN_PASSWORD=

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
